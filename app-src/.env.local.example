# STRWatch Next.js app — environment variables
#
# Copy to app-src/.env.local for local development. Every variable the app
# reads (grep process.env under app-src/src) is listed here. Placeholders only —
# never commit real values.
#
# Environments:
#   local        → this file, copied to .env.local
#   Vercel preview → Project → Settings → Environment Variables, scope "Preview"
#   Vercel production → same page, scope "Production"
# "Same in preview + prod" below means one value can be scoped to both.

# ── Clerk (auth) ────────────────────────────────────────────────────────────
# Read implicitly by @clerk/nextjs; the app will not boot without the two keys.
# Production already uses the pk_live_/sk_live_ keys for the production Clerk
# instance at clerk.strwatch.io, set in Vercel (scope: Production).
# Local and Vercel preview use pk_test_/sk_test_ keys from a Clerk
# *development* instance (Clerk Dashboard → pick the dev instance → API Keys).
# Publishable key. Clerk Dashboard → API Keys. DIFFERS: pk_test_ (local/preview) vs pk_live_ (prod).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE-ME
# Secret key, server-side only. Clerk Dashboard → API Keys. DIFFERS: sk_test_ vs sk_live_.
CLERK_SECRET_KEY=sk_test_REPLACE-ME
# Paths of the app's own sign-in/sign-up pages (src/app/(auth)/...). Same in preview + prod.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Where to land after auth when no redirect_url is present. Same in preview + prod.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Supabase (database) ─────────────────────────────────────────────────────
# Project URL. Supabase Dashboard → Project Settings → API. Same in preview + prod
# (one project today); required — no fallback, the app throws at startup if unset.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key, server-side only, bypasses RLS. Supabase Dashboard → Project
# Settings → API → service_role. Same in preview + prod. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx

# ── Stripe (billing) ────────────────────────────────────────────────────────
# Secret key. Stripe Dashboard → Developers → API keys. DIFFERS: sk_test_ (local/preview) vs sk_live_ (prod).
STRIPE_SECRET_KEY=sk_test_REPLACE-ME
# Webhook signing secret for the /api/stripe/webhook endpoint. Stripe Dashboard →
# Developers → Webhooks → endpoint → Signing secret. DIFFERS per endpoint: prod has
# its own endpoint; local uses the secret printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE-ME
# Price ID for the Pro tier. Stripe Dashboard → Product catalog → Pro → price.
# DIFFERS: test-mode price IDs (local/preview) vs live-mode price IDs (prod).
STRIPE_PRICE_PRO=price_REPLACE-ME
# Price ID for the Agency tier. Same source and same test/live split as above.
STRIPE_PRICE_AGENCY=price_REPLACE-ME

# ── Anthropic (AI market scans) ─────────────────────────────────────────────
# API key used by /api/scans/generate. console.anthropic.com → API Keys.
# Same key works in preview + prod; use a separate key per environment if you
# want spend isolated.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# ── App ─────────────────────────────────────────────────────────────────────
# Public origin of the app, no trailing slash. Used to build Stripe success/cancel
# URLs. DIFFERS: http://localhost:3000 (local), the preview deployment URL
# (preview), https://app.strwatch.io (prod).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated Clerk user IDs allowed to open /admin. Clerk Dashboard → Users →
# user → User ID. DIFFERS: dev-instance IDs (local/preview) vs prod-instance IDs (prod).
ADMIN_USER_IDS=user_xxxxxxxxxxxxxxxxxxxxxxxx,user_yyyyyyyyyyyyyyyyyyyyyyyy
