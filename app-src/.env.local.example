# ── Supabase ──────────────────────────────────────────────
# Project URL (public, safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon / public key (public, safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
# Service-role key — server-side only, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# ── Stripe ────────────────────────────────────────────────
# Secret key for server-side Stripe API calls
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret (from Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID for the Pro tier ($29/mo)
STRIPE_PRICE_PRO=price_...
# Price ID for the Agency tier
STRIPE_PRICE_AGENCY=price_...

# ── AI ────────────────────────────────────────────────────
# Claude API key for AI-powered market scan generation
ANTHROPIC_API_KEY=sk-ant-...

# ── App ───────────────────────────────────────────────────
# Full public URL of the app — used for Stripe redirect URLs
NEXT_PUBLIC_APP_URL=https://strwatch.com
