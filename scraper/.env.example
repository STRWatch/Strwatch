# STRWatch scraper — environment variables
#
# Copy to scraper/.env. Every variable the scraper reads (grep os.getenv /
# os.environ under scraper/) is listed here. Placeholders only — never commit
# real values.
#
# Loading: config.py, alerts/router.py and alerts/reminders.py each call plain
# load_dotenv(), which looks for .env relative to the current working directory.
# On the server this works only because the cron entry does
#   cd /root/strwatch-scraper && python3 run.py
# first. Running run.py from any other directory loads nothing.

# ── Supabase (database) ─────────────────────────────────────────────────────
# Project URL. Supabase Dashboard → Project Settings → API. Same project as the
# app's NEXT_PUBLIC_SUPABASE_URL. Required by alerts/router.py and
# alerts/reminders.py — no fallback, they raise at import if unset.
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key, bypasses RLS. Supabase Dashboard → Project Settings → API →
# service_role. Used by alerts/router.py and alerts/reminders.py to read
# user_markets / user_preferences / user_tiers and write alerts.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx
# Key used by config.py/db for the optional Supabase sync of scraped records
# (USE_SUPABASE is true only when both SUPABASE_URL and SUPABASE_KEY are set).
# Same source as above; the service-role key is fine here.
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx

# ── Clerk (auth) ────────────────────────────────────────────────────────────
# Secret key used to resolve a user's email from their Clerk user ID when
# sending alerts (alerts/router.py). Must be the key for the SAME Clerk
# instance the app runs against: sk_live_ for the production instance at
# clerk.strwatch.io; sk_test_ from a development instance when testing locally.
CLERK_SECRET_KEY=sk_live_REPLACE-ME

# ── Resend (alert email) ────────────────────────────────────────────────────
# API key. resend.com → API Keys.
RESEND_API_KEY=re_REPLACE-ME
# From address on a verified Resend domain. Display-name form is accepted.
RESEND_FROM=STRWatch <alerts@strwatch.io>

# ── Twilio (SMS alerts, Pro tier only) ──────────────────────────────────────
# Twilio Console → Account Info.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sending number in E.164 form. Twilio Console → Phone Numbers.
TWILIO_FROM=+15555550100

# ── Anthropic (AI compliance checklists) ────────────────────────────────────
# API key used by alerts/checklist.py. console.anthropic.com → API Keys.
# Leave empty to skip checklist generation.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Operator alerts (legacy single-recipient fallback in config.py) ──────────
# Email / phone that receive scraper-level alerts. Optional; empty disables.
ALERT_EMAIL=you@example.com
ALERT_PHONE=+15555550199

# ── Runtime ─────────────────────────────────────────────────────────────────
# Directory for the SQLite DB and scraped data. Defaults to scraper/data.
DATA_DIR=/root/strwatch-scraper/data
# Python logging level: DEBUG, INFO, WARNING, ERROR. Defaults to INFO.
LOG_LEVEL=INFO
